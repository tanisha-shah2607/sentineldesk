# Copy to .env (never commit .env). S4 decides the provider.
LLM_PROVIDER=none          # none (template replies only) | anthropic | vertex | groq | ollama
LLM_MODEL=                 # defaults: Claude claude-opus-5-5 (claude-haiku-5-5 is faster); groq openai/gpt-oss-120b; ollama llama3.1:8b
LLM_EFFORT=low             # Claude effort / gpt-oss reasoning effort: low | medium | high
LLM_TIMEOUT=30             # seconds per LLM call; on timeout the draft falls back to the template
# anthropic: direct Claude API key
ANTHROPIC_API_KEY=
# vertex: Claude on Google Cloud. No API key; run `gcloud auth application-default login` once.
ANTHROPIC_VERTEX_PROJECT_ID=   # Google Cloud project ID (empty = gcloud default project)
CLOUD_ML_REGION=global
LLM_FALLBACK_MODEL=claude-opus-4-8   # vertex refusal fallback; enable it in Model Garden too, or leave empty
# groq: free key from console.groq.com (gpt-oss-120b). Free tier: 8K tokens/min, 200K tokens/day.
GROQ_API_KEY=
LLM_MAX_PRECEDENTS=5        # precedents per draft; use 3 on groq's free tier
LLM_MAX_ANSWER_CHARS=1500   # chars of each precedent answer sent to the LLM; use 800 on groq's free tier
LLM_RATE_WAIT=10            # on HTTP 429, wait up to this many seconds before falling back to the template
OLLAMA_URL=http://localhost:11434

# Console (owner: Niti, optional)
SENTINELDESK_STRICT=0        # 1 = re-raise stage errors instead of falling back to demo mocks
SENTINELDESK_FORCE_MOCKS=    # e.g. "all" or "triage,retrieve" for UI rehearsal
